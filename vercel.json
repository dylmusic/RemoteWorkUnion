{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "work.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/airtable.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/og.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/canvas/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/airtable",
      "dest": "/api/airtable.js"
    },
    {
      "src": "/og-image",
      "dest": "/api/og.js"
    },
    {
      "src": "/work",
      "dest": "/work.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
